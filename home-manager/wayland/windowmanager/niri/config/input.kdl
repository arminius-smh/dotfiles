input {
    keyboard {
        xkb {
            layout "de" ;

            variant "deadtilde" ;

            options "caps:none,shift:both_capslock" ;
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
        accel-speed 0.9
        accel-profile "flat"
    }

    mouse {
        accel-speed 0.5
        accel-profile "flat"
    }

    warp-mouse-to-focus mode="center-xy"

    focus-follows-mouse max-scroll-amount="0%"

    trackpoint
}

